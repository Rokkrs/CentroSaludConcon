---
import "../styles/global.css";
import { site, withBase } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = `${site.name} | Atención profesional especializada`,
  description = site.description,
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(withBase("images/iid-logo.png"), Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0c3f4c" />
    <link rel="shortcut icon" type="image/x-icon" href={withBase("favicon.ico")} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase("favicon-search.png")} />
    <link rel="apple-touch-icon" sizes="160x160" href={withBase("favicon.png")} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="390" />
    <meta property="og:image:height" content="180" />
    <meta property="og:image:alt" content="Atención especializada en neurodivergencia de Instituto Incluidos" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Logo de Instituto Incluidos por Derecho" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
    <script is:inline>
      window.loadAnalytics = () => {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", "G-T55SJS5HXB");
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-T55SJS5HXB";
        document.head.appendChild(script);
      };
    </script>
  </head>
  <body>
    <script is:inline>
      if (new URLSearchParams(window.location.search).has("capture")) {
        document.documentElement.classList.add("capture-mode");
      }
    </script>
    <slot />
    <a class="whatsapp-float" href={site.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Resolver dudas o agendar por WhatsApp">
      <span class="whatsapp-float-copy"><strong>¿Tienes dudas?</strong><small>Escríbenos por WhatsApp</small></span>
      <span class="whatsapp-float-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.3-4.74A8.5 8.5 0 1 1 20.5 11.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path><path d="M8.2 7.8c.2-.45.4-.46.72-.47h.6c.18 0 .38.07.47.32l.72 1.74c.08.2.05.4-.08.57l-.55.7c-.14.17-.11.34-.02.5.55 1 1.35 1.8 2.33 2.36.17.1.34.11.5-.04l.8-.94c.16-.18.36-.2.56-.12l1.66.78c.24.11.4.19.43.31.04.13.04.73-.17 1.35-.22.62-1.25 1.18-1.74 1.25-.45.06-1.02.09-1.64-.1-.38-.12-.86-.28-1.48-.55a11.1 11.1 0 0 1-4.2-3.7c-.42-.57-1.12-1.52-1.12-2.9 0-1.39.72-2.07 1-2.35Z" fill="currentColor"></path></svg></span>
    </a>
    <aside class="cookie-banner" data-cookie-banner aria-label="Preferencias de cookies" hidden>
      <div class="cookie-banner-copy">
        <strong>Tu privacidad importa</strong>
        <p>Usamos cookies necesarias para el funcionamiento del sitio y, si lo autorizas, cookies analíticas para conocer qué contenidos y especialidades generan más interés.</p>
        <a href={withBase("documents/declaracion.pdf")} target="_blank" rel="noopener noreferrer">Conoce nuestra política de privacidad</a>
      </div>
      <div class="cookie-banner-actions">
        <button type="button" class="cookie-button cookie-button-secondary" data-cookie-reject>Rechazar</button>
        <button type="button" class="cookie-button cookie-button-primary" data-cookie-accept>Aceptar analíticas</button>
      </div>
    </aside>
    <script>
      const cookieBanner = document.querySelector("[data-cookie-banner]");
      const cookieChoice = window.localStorage.getItem("iid-cookie-consent");
      if (!cookieChoice) cookieBanner?.removeAttribute("hidden");
      if (cookieChoice === "accepted") (window as any).loadAnalytics?.();
      const saveCookieChoice = (choice: string) => {
        window.localStorage.setItem("iid-cookie-consent", choice);
        cookieBanner?.setAttribute("hidden", "true");
        if (choice === "accepted") (window as any).loadAnalytics?.();
      };
      document.querySelector("[data-cookie-accept]")?.addEventListener("click", () => saveCookieChoice("accepted"));
      document.querySelector("[data-cookie-reject]")?.addEventListener("click", () => saveCookieChoice("rejected"));

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const reveal = () => {
        const elements = document.querySelectorAll("[data-reveal]");
        if (reducedMotion.matches) {
          elements.forEach((element) => element.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        elements.forEach((element) => observer.observe(element));
      };
      reveal();
      document.addEventListener("astro:page-load", reveal);

      const trackEvent = (...args: unknown[]) => {
        (window as any).gtag?.(...args);
      };

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest("a[href]") as HTMLAnchorElement | null;
        if (!link) return;
        const href = link.href;
        let eventName: string | null = null;
        const service = link.dataset.service;
        const professional = link.dataset.professional;
        if (service) trackEvent("event", "select_service", { service_name: service });
        if (professional) trackEvent("event", "select_professional", { professional_name: professional });
        if (href.includes("wa.me")) eventName = "click_whatsapp";
        else if (href.includes("reservo.cl")) eventName = "click_reservar";
        else if (href.startsWith("mailto:")) eventName = "click_email";
        else if (href.includes("instagram.com")) eventName = "click_instagram";
        if (eventName) trackEvent("event", eventName);
      });

      const sectionEvents: Record<string, string> = { equipo: "view_equipo", servicios: "view_servicios" };
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const eventName = sectionEvents[entry.target.id];
            if (eventName) trackEvent("event", eventName);
            sectionObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.3 },
      );
      Object.keys(sectionEvents).forEach((id) => {
        const el = document.getElementById(id);
        if (el) sectionObserver.observe(el);
      });

    </script>
  </body>
</html>
