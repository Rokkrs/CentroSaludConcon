---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, withBase } from "../data/site";
---

<BaseLayout>
  <main class="splash">
    <img
      class="splash-logo"
      src={withBase("images/iid-logo.png")}
      alt={site.name}
      width="390"
      height="180"
    />
  </main>
</BaseLayout>

<style>
  .splash {
    align-items: center;
    background:
      radial-gradient(120% 120% at 50% 30%, rgba(217, 88, 50, 0.14), transparent 60%),
      linear-gradient(180deg, var(--ink-deep), #06262e);
    display: flex;
    justify-content: center;
    min-height: 100dvh;
    padding: 32px;
  }
  .splash-logo {
    animation: splash-in 0.9s ease both;
    filter: brightness(1.9) saturate(1.15);
    height: auto;
    width: clamp(220px, 30vw, 360px);
  }
  @keyframes splash-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-logo { animation: none; }
  }
</style>
