---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, withBase } from "../data/site";
---

<BaseLayout>
  <main class="splash">
    <div class="splash-card">
      <img
        class="splash-logo"
        src={withBase("images/iid-logo.png")}
        alt={site.name}
        width="390"
        height="180"
      />
    </div>
  </main>
</BaseLayout>

<style>
  .splash {
    align-items: center;
    background:
      radial-gradient(120% 120% at 50% 30%, rgba(217, 88, 50, 0.14), transparent 60%),
      linear-gradient(180deg, var(--ink-deep), #06262e);
    display: flex;
    justify-content: center;
    min-height: 100dvh;
    padding: 32px;
  }
  .splash-card {
    animation: splash-in 0.9s ease both;
    background: var(--paper);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    padding: clamp(28px, 5vw, 52px) clamp(36px, 7vw, 72px);
  }
  .splash-logo {
    display: block;
    height: auto;
    width: clamp(200px, 28vw, 340px);
  }
  @keyframes splash-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-card { animation: none; }
  }
</style>
