---
import { site } from "../data/site";
import { team } from "../data/team";
import SectionMarker from "./SectionMarker.astro";

interface Props { number?: string; }
const { number = "06" } = Astro.props;
---

<section id="equipo" class="section team-legacy section-identified" aria-labelledby="team-legacy-title">
  <SectionMarker number={number} label="Equipo interdisciplinario" />
  <div class="container">
    <div class="team-intro" data-reveal>
      <p class="eyebrow"><span></span> Equipo interdisciplinario</p>
      <h2 id="team-legacy-title">Especialistas dedicados a comprender <em>cada trayectoria neurodivergente</em></h2>
    </div>
    <div class="team-legacy-grid">
      {team.map((member) => (
        <article class="team-legacy-card" data-reveal>
          <div class="team-legacy-image"><img src={member.image} alt={`Retrato de ${member.name}`} width="800" height="1000" loading="lazy" /></div>
          <div class="team-legacy-content">
            <p class="team-legacy-role">{member.role}</p>
            <h3>{member.name}</h3>
            <div class="team-legacy-specialty"><span>Especialidad</span><p>{member.specialty}</p></div>
            <p class="team-legacy-bio">{member.bio}</p>
            <div class="team-legacy-credentials"><p>Formación y logros</p><ul>{member.credentials.map((item) => <li><span aria-hidden="true">✓</span>{item.text}</li>)}</ul></div>
            <a class="team-profile-link cta-link" href={site.reservo} target="_blank" rel="noopener noreferrer"><span class="cta-label">Consultar con {member.name.split(" ")[0]}</span><svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-legacy { background: var(--white); padding-bottom: 72px; }
  .team-legacy-grid { display: grid; gap: 26px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .team-legacy-card { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 14px 38px rgba(10,52,61,.055); display: flex; flex-direction: column; height: 100%; min-width: 0; overflow: hidden; transition: border-color .3s ease, box-shadow .3s ease, transform .3s ease; }
  .team-legacy-card:hover { border-color: rgba(16,59,69,.2); box-shadow: 0 20px 48px rgba(10,52,61,.09); transform: translateY(-4px); }
  .team-legacy-image { aspect-ratio: 4 / 4.55; flex: 0 0 auto; overflow: hidden; width: 100%; }
  .team-legacy-image img { filter: saturate(.84); height: 100%; object-fit: cover; object-position: center top; width: 100%; }
  .team-legacy-content { display: flex; flex: 1; flex-direction: column; padding: 26px 26px 28px; }
  .team-legacy-role { color: var(--coral); font-family: var(--serif); font-size: 1.2rem; font-style: italic; line-height: 1.2; margin: 0 0 5px; }
  .team-legacy-content h3 { color: var(--ink-soft); font-size: .78rem; letter-spacing: .07em; margin: 0 0 4px; text-transform: uppercase; }
  .team-legacy-specialty { border-bottom: 1px solid var(--line); border-top: 1px solid var(--line); margin: 18px 0; padding: 13px 0; }
  .team-legacy-specialty span, .team-legacy-credentials > p { color: var(--muted); display: block; font-size: .58rem; font-weight: 600; letter-spacing: .1em; margin: 0 0 4px; text-transform: uppercase; }
  .team-legacy-specialty p { color: var(--coral); font-family: var(--serif); font-size: 1rem; line-height: 1.45; margin: 0; }
  .team-legacy-bio { color: var(--muted); font-size: .76rem; line-height: 1.55; margin: 0; }
  .team-legacy-credentials { background: var(--white); border-left: 2px solid var(--ink-soft); margin-top: 15px; padding: 15px 16px; }
  .team-legacy-credentials > p { color: var(--ink); margin-bottom: 9px; }
  .team-legacy-credentials ul { list-style: none; margin: 0; padding: 0; }
  .team-legacy-credentials li { color: var(--muted); display: flex; font-size: .69rem; gap: 8px; line-height: 1.4; padding: 3px 0; }
  .team-legacy-credentials li span { color: var(--coral); }
  .team-legacy-card .team-profile-link { margin-top: auto; }
  @media (max-width: 980px) { .team-legacy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .team-legacy-grid { grid-template-columns: 1fr; } }
</style>
