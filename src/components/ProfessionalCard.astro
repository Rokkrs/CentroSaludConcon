---
import { site } from "../data/site";

interface Credential {
  label: string;
  text: string;
}

interface Props {
  member: {
    name: string;
    role: string;
    specialty: string;
    credentials: Credential[];
    bio: string;
    image: string;
  };
}

const { member } = Astro.props;
const consultationName = member.name.split(" ")[0];
---

<article class="team-card" data-reveal>
  <header class="team-card-header">
    <div class="team-image">
      <img src={member.image} alt={`Retrato de ${member.name}`} width="800" height="800" loading="lazy" />
    </div>
    <div class="team-heading">
      <p class="team-name">{member.name}</p>
      <h3 class="team-role">{member.role}</h3>
      <p class="team-specialty">{member.specialty}</p>
    </div>
  </header>
  <div class="team-content">
    <p class="team-bio">{member.bio}</p>

    {member.credentials.length > 0 && (
      <div class="team-credentials">
        <p>Experiencia que destaca</p>
        {member.credentials.map((item) => (
          <div class="team-credential">
            <div>
              <p class="team-credential-label">{item.label}</p>
              <p class="team-credential-text">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    )}

    <a class="team-profile-link cta-link" href={site.reservo} target="_blank" rel="noopener noreferrer">
      <span class="cta-label">Consultar con {consultationName}</span>
      <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
      </svg>
    </a>
  </div>
</article>
