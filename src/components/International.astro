---
import SectionMarker from "./SectionMarker.astro";
import { withBase } from "../data/site";

const partners = [
  { name: "Institute of Neurodiversity", logo: "images/partners/ion-logo.png", url: "https://ioneurodiversity.org/" },
  { name: "Global Neurodiversity Association", logo: "images/partners/gna-logo.svg", url: "https://gnaglobal.org/" },
  { name: "Autism CRC", logo: "images/partners/autismcrc-logo.svg", url: "https://www.autismcrc.com.au/" },
];
---

<section class="international section-identified" aria-label="Compromiso internacional">
  <SectionMarker number="03" label="Compromiso internacional" />
  <div class="container international-grid" data-reveal>
    <ul class="partner-row" aria-label="Instituciones internacionales vinculadas">
      {partners.map((partner) => (
        <li>
          <a href={partner.url} target="_blank" rel="noopener noreferrer">
            <img src={withBase(partner.logo)} alt={partner.name} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
