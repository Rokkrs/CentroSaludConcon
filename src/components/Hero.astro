---
import { site, withBase } from "../data/site";
---

<main id="inicio">
  <section class="hero">
    <div class="hero-orbit orbit-one" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span></span> Ciencia · investigación · derechos · inclusión</p>
        <h1>Centro de Referencia en <em>Neurodivergencia</em> de Chile</h1>
        <p class="hero-lead">
          Evaluación e intervención interdisciplinaria en neurodivergencia para niños, adolescentes y adultos, con atención presencial en Viña del Mar y online para todo Chile.
        </p>
        <div class="hero-actions">
          <div class="hero-cta">
            <a class="button button-reserve button-large" href={site.reservo} target="_blank" rel="noopener noreferrer"><span>Agendar una evaluación</span></a>
            <p class="hero-cta-note"><span aria-hidden="true"></span> Atención online y presencial</p>
          </div>
          <div class="hero-secondary-actions">
            <a class="text-link cta-link" href="#servicios">
              <span class="cta-label">Ver especialidades</span>
              <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
              </svg>
            </a>
            <a class="hero-guidance-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer">¿No sabes qué atención necesitas?<span>Te orientamos.</span></a>
          </div>
        </div>
      </div>

      <div class="hero-visual" data-reveal>
        <div class="hero-photo-wrap">
          <img
            src={withBase("images/hero-trust.png")}
            alt="Instituto Incluidos por Derecho: ciencia, derechos e inclusión"
            width="1086"
            height="1448"
            fetchpriority="high"
          />
          <div class="photo-wash" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>
</main>
