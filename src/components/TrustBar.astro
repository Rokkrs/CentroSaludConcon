---
import SectionMarker from "./SectionMarker.astro";
import { site } from "../data/site";

const items = [
  { value: "4.500+", label: "Evaluaciones y atenciones", stat: true },
  { value: "15", label: "Regiones de Chile atendidas", stat: true },
  { value: "Experiencia clínica", label: "Atención nacional e internacional", stat: false },
  { value: "Presencial y online", label: "Viña del Mar y todo Chile", stat: false, href: site.reservo },
];
---

<section class="trust-bar section-identified" aria-label="Nuestros pilares">
  <SectionMarker number="02" label="Indicadores de confianza" />
  <div class="container trust-grid">
    {items.map((item) =>
      item.href ? (
        <a class="trust-item trust-item-link" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.value}: agenda tu evaluación`}>
          <span class={item.stat ? "trust-number" : "trust-claim"}>{item.value}</span>
          <p>{item.label}</p>
        </a>
      ) : (
        <div class="trust-item">
          <span class={item.stat ? "trust-number" : "trust-claim"}>{item.value}</span>
          <p>{item.label}</p>
        </div>
      ),
    )}
  </div>
</section>
