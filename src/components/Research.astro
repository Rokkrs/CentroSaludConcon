---
import { achievements } from "../data/achievements";
import SectionMarker from "./SectionMarker.astro";
---

<section id="trayectoria" class="section research section-identified" aria-labelledby="research-title">
  <SectionMarker number="07" label="Investigación y trayectoria" />
  <div class="container research-grid">
    <div class="research-copy" data-reveal>
      <p class="eyebrow"><span></span> Investigación y trayectoria</p>
      <h2 id="research-title">Ciencia y actualización para una práctica clínica <em>que evoluciona.</em></h2>
      <p>Investigación, docencia y participación en redes internacionales fortalecen cada decisión clínica y mantienen al equipo conectado con los avances en neurodiversidad.</p>
      <blockquote>“Ciencia, investigación, derechos e inclusión.”</blockquote>
    </div>
    <div class="achievement-list">
      {achievements.map((item, index) => (
        <article data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><h3>{item.title}</h3><p>{item.text}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
