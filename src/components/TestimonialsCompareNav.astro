---
import { withBase } from "../data/site";

const options = [
  { number: "01", label: "Grilla de cards", href: withBase("testimonios/cards/") },
  { number: "02", label: "Destacado + cards", href: withBase("testimonios/destacado/") },
  { number: "03", label: "Por categorías", href: withBase("testimonios/categorias/") },
];
---

<nav class="compare-nav" aria-label="Comparar versiones de testimonios">
  <div class="container compare-nav-inner">
    <a class="compare-back" href={withBase("testimonios/")}>← Comparar versiones</a>
    <div>{options.map((option) => <a href={option.href}><span>{option.number}</span>{option.label}</a>)}</div>
  </div>
</nav>
