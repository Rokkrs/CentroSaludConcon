---
const options = [
  { number: "01", label: "Grilla de cards", href: "/testimonios/cards/" },
  { number: "02", label: "Destacado + cards", href: "/testimonios/destacado/" },
  { number: "03", label: "Por categorías", href: "/testimonios/categorias/" },
];
---

<nav class="compare-nav" aria-label="Comparar versiones de testimonios">
  <div class="container compare-nav-inner">
    <a class="compare-back" href="/testimonios/">← Comparar versiones</a>
    <div>{options.map((option) => <a href={option.href}><span>{option.number}</span>{option.label}</a>)}</div>
  </div>
