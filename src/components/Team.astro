---
import { team } from "../data/team";
import SectionMarker from "./SectionMarker.astro";
---

<section id="equipo" class="section team section-identified" aria-labelledby="team-title">
  <SectionMarker number="06" label="Equipo interdisciplinario" />
  <div class="container">
    <div class="team-intro" data-reveal>
      <div>
        <p class="eyebrow"><span></span> Equipo interdisciplinario</p>
        <h2 id="team-title">Especialistas dedicados a comprender<br /><em>cada trayectoria neurodivergente.</em></h2>
      </div>
      <p>Trayectoria clínica, formación especializada y actualización científica permanente.</p>
    </div>
    <div class="team-grid">
      {team.map((member, index) => (
        <article class={`team-card team-card-${index + 1}`} data-reveal>
          <div class="team-image">
            <img src={member.image} alt={`Retrato de ${member.name}`} width="800" height="1000" loading="lazy" />
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>
          <div class="team-content">
            <p class="team-role">{member.role}</p>
            <h3>{member.name}</h3>
            <div class="team-specialty-block">
              <span>Especialidad</span>
              <p class="team-specialty">{member.specialty}</p>
            </div>
            <p>{member.bio}</p>
            {member.credentials?.length > 0 && (
              <div class="team-credentials">
                <p>Estudios y certificaciones</p>
                <ul>{member.credentials.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
              </div>
            )}
            <a class="team-profile-link" href="#contacto">Consultar con {member.name.split(" ")[1]} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="content-note">Especialidad, biografía y credenciales de cada profesional están pendientes de validación.</p>
  </div>
</section>
