---
import { team } from "../data/team";
import ProfessionalCard from "./ProfessionalCard.astro";
import SectionMarker from "./SectionMarker.astro";

interface Props {
  number?: string;
}

const { number = "06" } = Astro.props;
---

<section id="equipo" class="section team section-identified" aria-labelledby="team-title">
  <SectionMarker number={number} label="Equipo interdisciplinario" />
  <div class="container">
    <div class="team-intro" data-reveal>
      <p class="eyebrow"><span></span> Equipo interdisciplinario</p>
      <h2 id="team-title">Especialistas dedicados a comprender <em>cada trayectoria neurodivergente</em></h2>
    </div>
    <div class="team-grid">
      {team.map((member) => <ProfessionalCard member={member} />)}
    </div>
  </div>
</section>
