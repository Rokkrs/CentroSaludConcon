---
import { achievements } from "../data/achievements";

const attributes = [
  { label: "Atención ética y profesional", icon: "brain" },
  { label: "Formación continua", icon: "book" },
  { label: "Trabajo interdisciplinario", icon: "briefcase" },
  { label: "Acompañamiento personalizado", icon: "face" },
];
---

<section class="section about" aria-label="Quiénes somos">
  <div class="container split-layout">
    <div class="about-intro-image" data-reveal>
      <p class="eyebrow"><span></span> Quiénes somos</p>
      <div class="about-map-frame">
        <iframe
          title="Ubicación del Instituto Incluidos por Derecho"
          src="https://www.google.com/maps?q=7%20Norte%20645%2C%20Vi%C3%B1a%20del%20Mar%2C%20Chile&layer=c&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <a class="about-map-link cta-link" href="https://www.google.com/maps/search/?api=1&query=7%20Norte%20645%2C%20Vi%C3%B1a%20del%20Mar%2C%20Chile" target="_blank" rel="noopener noreferrer">
        <span class="cta-label">Ver ubicación y recorrido virtual</span>
        <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
        </svg>
      </a>
    </div>
    <div class="about-copy" data-reveal>
      <p class="large-copy">Creemos en una atención donde la evidencia y la empatía no compiten: se complementan.</p>
      <p>Reunimos distintas especialidades para comprender a cada persona de manera integral, tomar decisiones informadas y construir un camino posible junto a ella y su entorno.</p>
      <ul class="check-list">
        {attributes.map((attribute) => (
          <li>
            <span class="about-attribute-icon" aria-hidden="true">
              {attribute.icon === "brain" && <svg viewBox="0 0 24 24"><path d="M9.5 4.3A3.3 3.3 0 0 0 6 7.5a3.2 3.2 0 0 0 .2 1.1A3.5 3.5 0 0 0 5 15a3.4 3.4 0 0 0 3 3.4V20h3V4.6a3.2 3.2 0 0 0-1.5-.3ZM14.5 4.3A3.3 3.3 0 0 1 18 7.5a3.2 3.2 0 0 1-.2 1.1A3.5 3.5 0 0 1 19 15a3.4 3.4 0 0 1-3 3.4V20h-3V4.6a3.2 3.2 0 0 1 1.5-.3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" /></svg>}
              {attribute.icon === "book" && <svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21V5.5ZM20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5A2.5 2.5 0 0 1 20 21V5.5Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" /></svg>}
              {attribute.icon === "briefcase" && <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 7V5a1.5 1.5 0 0 1 1.5-1.5h5A1.5 1.5 0 0 1 16 5v2M3 12h18M10 12v2h4v-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" /></svg>}
              {attribute.icon === "face" && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="9" cy="10" r=".8" fill="currentColor" /><circle cx="15" cy="10" r=".8" fill="currentColor" /><path d="M8.5 14a4.5 4.5 0 0 0 7 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.3" /></svg>}
            </span>
            {attribute.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div id="trayectoria" class="container research-strip" data-reveal>
    <p class="eyebrow"><span></span> Investigación y trayectoria</p>
    <div class="achievement-grid">
      {achievements.map((item) => (
        <article>
          <div><h3>{item.title}</h3><p>{item.text}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
