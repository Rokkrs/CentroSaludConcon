---
import { services } from "../data/services";
import { site, withBase } from "../data/site";
import { servicePages } from "../data/servicePages";

const clinicalServices = services.filter((service) => service.category === "clinical");
const assessments = services.filter((service) => service.category === "assessment");
const subspecialties = services.filter((service) => service.category === "subspecialty");
---

<section id="servicios" class="section services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow light"><span></span> Nuestras especialidades</p>
        <h2 id="services-title">Evaluación e intervención<br /><em>exclusivamente en neurodivergencia</em></h2>
      </div>
      <p>Especialidades coordinadas para niños, adolescentes y adultos.</p>
    </div>
    <div class="service-group" data-reveal>
      <div class="service-group-heading">
        <div><h3>Atención clínica</h3><p>Acompañamiento profesional interdisciplinario.</p></div>
      </div>
      <div class="services-grid services-grid-clinical">
        {clinicalServices.map((service) => (
          <article class="service-card" data-reveal>
            <div class="service-card-content">
              <div class="service-card-copy"><h3>{service.title}</h3><p>{service.description}</p></div>
              <a class="cta-link" data-service={service.title} href={site.reservo} target="_blank" rel="noopener noreferrer" aria-label={`Agendar ${service.title}`}>
                <span class="cta-label">Agendar atención</span>
                <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="service-group service-group-assessments" data-reveal>
      <div class="service-group-heading">
        <div><h3>Evaluaciones especializadas</h3><p>Procesos rigurosos para orientar decisiones clínicas.</p></div>
      </div>
      <div class="services-grid services-grid-assessments">
        {assessments.map((service) => (
          <article class="service-card service-card-assessment" data-reveal>
            <div class="service-card-content">
              <div class="service-card-copy">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <p class="service-specialists"><strong>Agenda con:</strong> {service.specialists?.join(" y ")}</p>
              </div>
              <a class="cta-link" data-service={service.title} href={site.reservo} target="_blank" rel="noopener noreferrer" aria-label={`Agendar ${service.title}`}>
                <span class="cta-label">Agendar evaluación</span>
                <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="service-group service-group-subspecialties" data-reveal>
      <div class="service-group-heading">
        <div>
          <h3>Tratamientos de subespecialización</h3>
          <p>Atenciones especializadas en TEA, TDA, TDAH y AACC.</p>
        </div>
      </div>
      <div class="services-grid services-grid-subspecialties">
        {subspecialties.map((service) => (
          <article class="service-card service-card-subspecialty" data-reveal>
            <div class="service-card-content">
              <div class="service-card-copy">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <p class="service-specialists"><strong>Agenda con:</strong> {service.specialists?.join(" y ")}</p>
              </div>
              <a class="cta-link" data-service={service.title} href={site.reservo} target="_blank" rel="noopener noreferrer" aria-label={`Agendar ${service.title} con Carolina Jiménez`}>
                <span class="cta-label">Agendar atención</span>
                <svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <nav class="services-guides" aria-labelledby="services-guides-title" data-reveal>
      <h3 id="services-guides-title">Conoce más sobre cada especialidad</h3>
      <ul>
        {servicePages.map((page) => <li><a href={withBase(`especialidades/${page.slug}/`)}>{page.label}</a></li>)}
      </ul>
    </nav>
  </div>
</section>
