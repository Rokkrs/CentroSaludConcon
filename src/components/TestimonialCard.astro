---
interface Props {
  quote: string;
  author: string;
  context: string;
  validated?: boolean;
  featured?: boolean;
  rating?: number;
}

const { quote, author, context, validated = false, featured = false, rating = 5 } = Astro.props;
---

<article class:list={["testimonial-card-simple", { "testimonial-card-featured": featured }]}>
  <div class="testimonial-rating" aria-label={`${rating} de 5 estrellas`}>
    {Array.from({ length: 5 }).map((_, index) => (
      <svg class:list={["star-icon", { "star-icon-filled": index < rating }]} aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
        <path fill="currentColor" d="M12 2.5l2.95 6.4 6.98.62-5.3 4.62 1.6 6.86L12 17.4l-6.23 3.6 1.6-6.86-5.3-4.62 6.98-.62z" />
      </svg>
    ))}
  </div>
  <blockquote>{quote}</blockquote>
  <footer>
    <div><strong>{author}</strong><span>{context}</span></div>
    {!validated && <small>Contenido demostrativo</small>}
  </footer>
</article>
